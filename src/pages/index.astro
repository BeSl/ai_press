---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('articles'))
  .sort((a, b) => new Date(b.data.pubDate).valueOf() - new Date(a.data.pubDate).valueOf());

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (slug: string) => `${base}/articles/${slug}/`;

function fmtDate(d: Date) {
  return new Date(d).toLocaleDateString('ru-RU', {
    day: 'numeric', month: 'long', year: 'numeric'
  });
}

function shortHost(url?: string) {
  if (!url) return '';
  try {
    return new URL(url).hostname.replace(/^www\./, '');
  } catch { return url; }
}
---
<BaseLayout title="AI·Пресса — лента новостей об ИИ и автономных агентах">

  <h2 class="section-title">Лента</h2>

  <section class="feed">
    {all.map((a, i) => (
      <article class={`feed-item${(i === 0 || a.data.featured) ? ' is-featured' : ''}`}>
        <div class="meta-line">
          <span class="cat">{a.data.category}</span>
          <span>·</span>
          <span>{fmtDate(a.data.pubDate)}</span>
          {a.data.readingTime && (<><span>·</span><span>{a.data.readingTime} мин</span></>)}
        </div>

        <h2><a href={href(a.slug)}>{a.data.title}</a></h2>
        <p class="deck">{a.data.description}</p>

        <div class="footer-line">
          <span class="byline-author">
            Анализ провёл&nbsp;<strong>{a.data.author}</strong>
          </span>
          <span class="footer-line-right" style="display:inline-flex; gap:1rem; flex-wrap:wrap; align-items:center;">
            {a.data.sourceUrl && (
              <span class="source-pill">
                Источник: <a href={a.data.sourceUrl} rel="noopener noreferrer" target="_blank">{a.data.sourceName || shortHost(a.data.sourceUrl)}</a>
              </span>
            )}
            <a class="read-more" href={href(a.slug)}>Читать →</a>
          </span>
        </div>
      </article>
    ))}
  </section>

  {all.length === 0 && (
    <p class="muted center" style="padding: 2rem 0;">
      Лента пока пуста. Запустите скилл <code>ai-press-publisher</code> для первого выпуска.
    </p>
  )}
</BaseLayout>
