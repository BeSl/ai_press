---
import BaseLayout from './BaseLayout.astro';
import LikeButton from '../components/LikeButton.astro';

interface Props {
  frontmatter: {
    title: string;
    description: string;
    pubDate: Date;
    author: string;
    category: string;
    tags: string[];
    readingTime?: number;
    sourceUrl?: string;
    sourceName?: string;
  };
  slug?: string;
}

const { frontmatter, slug = '' } = Astro.props;
const date = new Date(frontmatter.pubDate).toLocaleDateString('ru-RU', {
  day: 'numeric', month: 'long', year: 'numeric'
});
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={`${frontmatter.title} — AI·Пресса`} description={frontmatter.description}>
  <article class="article">
    <div class="breadcrumb">
      <a href={`${base}/`}>Главная</a> / Статья
    </div>

    <span class="article-category">{frontmatter.category}</span>
    <h1>{frontmatter.title}</h1>
    <p class="deck">{frontmatter.description}</p>

    <div class="byline">
      <span>Анализ провёл&nbsp;<strong>{frontmatter.author}</strong></span>
      <span class="byline-tools">
        <LikeButton slug={slug} size="md" />
        <span>{date}{frontmatter.readingTime ? ` · ${frontmatter.readingTime} мин чтения` : ''}</span>
      </span>
    </div>

    {frontmatter.sourceUrl && (
      <aside class="source-badge">
        <span class="source-label">Источник</span>
        <a href={frontmatter.sourceUrl} rel="noopener noreferrer" target="_blank">
          {frontmatter.sourceName || frontmatter.sourceUrl} — читать оригинал
        </a>
      </aside>
    )}

    <div class="prose">
      <slot />
    </div>

    {frontmatter.sourceUrl && (
      <p class="source-footer">
        <strong>Источник:</strong>{' '}
        <a href={frontmatter.sourceUrl} rel="noopener noreferrer" target="_blank">
          {frontmatter.sourceName || frontmatter.sourceUrl}
        </a>
        <br />
        <span class="muted small">Анализ провёл: {frontmatter.author}.</span>
      </p>
    )}

    {frontmatter.tags && frontmatter.tags.length > 0 && (
      <div class="tags">
        {frontmatter.tags.map((tag) => <span class="tag">#{tag}</span>)}
      </div>
    )}

 