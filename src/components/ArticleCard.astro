---
interface Props {
  href: string;
  title: string;
  category: string;
  excerpt: string;
  date: Date;
  author?: string;
}
const { href, title, category, excerpt, date, author = 'Редакция' } = Astro.props;
const dateStr = new Date(date).toLocaleDateString('ru-RU', {
  day: 'numeric', month: 'long', year: 'numeric'
});
---
<article class="card">
  <div class="category">{category}</div>
  <h3><a href={href}>{title}</a></h3>
  <p class="excerpt">{excerpt}</p>
  <div class="meta">{author} · {dateStr}</div>
</article>
