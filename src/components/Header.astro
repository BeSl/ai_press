---
const today = new Date().toLocaleDateString('ru-RU', {
  weekday: 'long',
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});

import { getCollection } from 'astro:content';
import { THEMES } from '../lib/themes';
const all = await getCollection('articles');
const issueNumber = String(all.length || 1).padStart(3, '0');

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<header class="masthead">
  <div class="container">
    <div class="masthead-top">
      <span>Выпуск № {issueNumber}</span>
      <span>{today}</span>
      <span>Цена: бесплатно</span>
    </div>

    <h1 class="masthead-title">
      <a href={`${base}/`}>AI<span class="accent">·</span>ПРЕССА</a>
    </h1>
    <p class="masthead-sub">Газета об искусственном интеллекте и автономных агентах</p>

    <nav class="nav">
      <ul class="nav-list">
        <li><a href={`${base}/`}>Лента</a></li>
        {THEMES.map((t) => (
          <li><a href={`${base}/theme/${t.slug}/1/`}>{t.label}</a></li>
        ))}
        <li><a href={`${base}/about/`}>О газете</a></li>
      </ul>
    </nav>
  </div>
</header>
